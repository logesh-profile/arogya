# Google Gemini API Key for Evidence-Grounded Symptom Evaluation & Conversational Reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Web Client ID (100% Free from Google Cloud Console -> APIs & Services -> Credentials)
# Leave blank or set your client ID: e.g. 123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Server Configuration
PORT=8000
HOST=127.0.0.1

